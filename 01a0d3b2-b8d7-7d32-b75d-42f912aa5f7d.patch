+        <div class="col-md-1">
+            <label class="form-label small text-muted">SSH-порт</label>
+            <input type="number" name="port" class="form-control" value="2222" required>
+        </div>
+        <div class="col-md-2">
+            <button type="submit" class="btn btn-success w-100 rounded-pill">Добавить</button>
+        </div>
+    </form>
+    <small class="text-muted d-block mt-2">На сервере должен быть развернут AmneziaWG со скриптами add_user.sh / remove_user.sh и настройкой SSH.</small>
+</div>
+
+{% for s in servers %}
+<div class="card card-custom p-4 mb-3">
+    <form method="post" action="/admin/web/servers/update">
+        <input type="hidden" name="server_id" value="{{ s.id }}">
+        <div class="d-flex justify-content-between flex-wrap gap-2 mb-3">
+            <div>
+                <b>#{{ s.id }} · <code>{{ s.ip }}</code>:{{ s.port }}</b>
+                <span class="badge {{ 'bg-success' if s.active else 'bg-secondary' }} ms-1">{{ 'активен' if s.active else 'выключен' }}</span>
+                {% if free_flags.get(s.id) %}<span class="badge bg-info ms-1" title="Бесплатная нода: выдается только на сайте /free, в Telegram не показывается">🎁 сайт-only</span>{% endif %}
+                <small class="text-muted ms-2">занято мест: {{ s.paid }}/{{ s.limit }} · подписок: {{ s.subs_total }} (акт. {{ s.subs_active }})</small>
+            </div>
+            <div class="d-flex gap-2">
+                <button type="submit" class="btn btn-primary btn-sm rounded-pill">💾 Сохранить</button>
+                {% if s.active %}
+                <button type="submit" formaction="/admin/web/servers/delete" name="mode" value="disable" class="btn btn-outline-warning btn-sm rounded-pill"
+                        title="Убрать из продажи (конфиги продолжат работать)"
+                        onclick="return confirm('Выключить сервер #{{ s.id }} — убрать из продажи? Выданные конфиги продолжат работать до истечения.')">⏸ Выкл</button>
+                {% endif %}
+                <button type="submit" formaction="/admin/web/servers/awg-update" class="btn btn-outline-info btn-sm rounded-pill"
+                        title="Обновить контейнер AmneziaWG на ноде до свежей сборки. Конфиги клиентов не слетят и перекачивать их не нужно."
+                        onclick="return confirm('Обновить контейнер AWG на ноде {{ s.ip }} до свежей сборки?\n\nДаунтайм ~10 секунд, все выданные конфиги продолжат работать.')">🔄 Обновить AWG</button>
+                <button type="submit" formaction="/admin/web/servers/delete" name="mode" value="permanent" class="btn btn-outline-danger btn-sm rounded-pill"
+                        title="Удалить из базы насовсем"
+                        onclick="return confirm('УДАЛИТЬ сервер #{{ s.id }} насовсем из базы?\n\nНа нем подписок: {{ s.subs_total }} (активных: {{ s.subs_active }}).\nСама VPN-нода не трогается, выданные конфиги доживут свой срок.')">🗑 Удалить</button>
+            </div>
+        </div>
+        <div class="row g-2 align-items-end">
+            <div class="col-md-3">
+                <label class="form-label small text-muted">Название</label>
+                <input type="text" name="name" class="form-control form-control-sm" value="{{ s.name }}">
