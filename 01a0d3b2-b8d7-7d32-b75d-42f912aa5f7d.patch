+            <small>AmneziaWG VPN</small>
+        </div>
+        <a href="/dashboard" class="btn btn-light btn-sm rounded-pill px-3">← В кабинет</a>
+    </div>
+</div>
+
+<div class="container pb-5">
+
+    <ul class="nav nav-pills nav-fill mb-4 bg-white rounded-pill p-1 shadow-sm">
