+{% extends "admin_base.html" %}
+{% block content %}
+
+<div class="card card-custom p-4 mb-4">
+    {% if ok %}
+    <h5 class="fw-bold text-success mb-2">✅ Сервер «{{ name }}» ({{ ip }}) установлен и добавлен в продажу!</h5>
+    <p class="mb-2">Внешний UDP-порт AmneziaWG: <b>{{ udp_port }}</b>
+        {% if udp_port %}<small class="text-muted">(откройте его в панели хостера, если там есть внешний firewall)</small>{% endif %}</p>
+    <div class="d-flex gap-2 flex-wrap">
+        <a href="/admin/web/servers" class="btn btn-primary rounded-pill">К списку серверов</a>
+        <a href="/admin/web/users" class="btn btn-outline-success rounded-pill">Выдать тестовый доступ</a>
+        <a href="/admin/web/servers/wizard" class="btn btn-outline-secondary rounded-pill">Установить ещё один</a>
+    </div>
+    {% else %}
+    <h5 class="fw-bold text-danger mb-2">❌ Установка не завершена</h5>
+    {% if error %}<div class="alert alert-danger rounded-3">{{ error }}</div>{% endif %}
+    <p class="text-muted small">Типичные причины: неверный SSH-порт/пароль; порт закрыт firewall; у хостера нет доступа к docker-репозиториям.
+    Исправьте и запустите мастер снова — повторный запуск безопасен: уже сделанные шаги будут пропущены.</p>
+    <a href="/admin/web/servers/wizard" class="btn btn-outline-primary rounded-pill">← Назад к мастеру</a>
+    {% endif %}
+</div>
+
+<div class="card card-custom p-4">
+    <h6 class="fw-bold mb-3">📜 Лог установки</h6>
+    <pre class="cfg-pre small p-3 mb-0" style="white-space:pre-wrap">{{ log }}</pre>
+</div>
+
+{% endblock %}
