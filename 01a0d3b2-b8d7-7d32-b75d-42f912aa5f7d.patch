+{% extends "admin_base.html" %}
+{% block content %}
+
+<div class="card card-custom p-4 mb-4 border-warning" style="border-left:4px solid #ffc107">
+    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
+        <div>
+            <h5 class="fw-bold mb-1">🧙‍♂️ Новый VPN-сервер? Запустите мастер установки</h5>
+            <small class="text-muted">Нужен только IP и root-пароль VPS: ключи, установка AmneziaWG, скрипты и занесение в базу — автоматически.</small>
+        </div>
+        <a href="/admin/web/servers/wizard" class="btn btn-warning rounded-pill px-4 fw-bold">🚀 Мастер установки</a>
+        {% if autoupdate %}<span class="badge bg-success ms-2">Автообновление нод: ВКЛ (ежедневно 05:05)</span>
