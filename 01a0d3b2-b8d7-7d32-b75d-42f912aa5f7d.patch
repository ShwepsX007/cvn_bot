+        <li class="nav-item"><a class="nav-link rounded-pill {{ 'active' if page == 'users' }}" href="/admin/web/users">👥 Клиенты</a></li>
+        <li class="nav-item"><a class="nav-link rounded-pill {{ 'active' if page == 'servers' }}" href="/admin/web/servers">🖥 Серверы</a></li>
+        <li class="nav-item"><a class="nav-link rounded-pill {{ 'active' if page == 'requests' }}" href="/admin/web/requests">📥 Заявки</a></li>
+        <li class="nav-item"><a class="nav-link rounded-pill {{ 'active' if page == 'settings' }}" href="/admin/web/settings">⚙️ Настройки</a></li>
+        <li class="nav-item"><a class="nav-link rounded-pill {{ 'active' if page == 'admins' }}" href="/admin/web/admins">🛡 Админы</a></li>
+        <li class="nav-item"><a class="nav-link rounded-pill {{ 'active' if page == 'broadcast' }}" href="/admin/web/broadcast">📢 Рассылка</a></li>
