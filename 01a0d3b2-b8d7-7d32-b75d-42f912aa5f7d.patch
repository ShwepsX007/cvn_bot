index 0000000..d23318b
--- /dev/null
+++ b/templates/free_config.html
@@ -0,0 +1,139 @@
+<!DOCTYPE html>
+<html lang="ru" data-bs-theme="dark">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Получить бесплатный конфиг — AmneziaWG</title>
+    <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
+    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
+    <style>
+        body { background-color: #f4f7f6; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
+        .topbar { background: linear-gradient(135deg, #198754, #0dcaf0); color: #fff; padding: 22px 0; border-radius: 0 0 28px 28px; margin-bottom: 30px; }
+        .card-custom { border: none; border-radius: 18px; box-shadow: 0 5px 20px rgba(0,0,0,0.05); }
+        .server-card input[type=radio] { display:none; }
+        .server-card { cursor:pointer; }
+        .server-card.active-server { outline: 2px solid #198754; }
+    </style>
+    <link rel="stylesheet" href="/static/dark-theme.css">
+</head>
+<body>
+
+<div class="topbar">
+    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
+        <div>
+            <h4 class="fw-bold mb-0">Получить бесплатный конфиг</h4>
+            <small>шаг 2 из 2 · на {{ free_hours }} ч, продление так же, с этой страницы</small>
+        </div>
+        <a href="/free" class="btn btn-light btn-sm rounded-pill px-3">← К инструкции</a>
+    </div>
+</div>
+
+<div class="container pb-5">
+
+    {% if msg %}<div class="alert alert-success rounded-3">{{ msg }}</div>{% endif %}
+    {% if error %}<div class="alert alert-danger rounded-3">{{ error }}</div>{% endif %}
+
+{% if mode == "active" %}
+    <!-- Активная бесплатная запись: скачать / продлить -->
+    <div class="card card-custom p-4 p-md-5 text-center">
+        <h4 class="fw-bold mb-1">✅ Ваш бесплатный конфиг активен</h4>
+        <p class="text-muted mb-4">Сервер: <b>{{ srv_name }}</b> · действует до: <b>{{ expires_at }}</b> (UTC)</p>
+
+        <div class="d-flex justify-content-center flex-wrap gap-3 mb-4">
+            <a href="/free/download/{{ token }}" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold">⬇️ Скачать FREE.conf</a>
+        </div>
+
+        <div class="mx-auto mb-4 p-3 bg-white rounded-4" style="max-width:220px">
+            <img src="/free/qr/{{ token }}" alt="QR код конфигурации" class="img-fluid">
+        </div>
+        <p class="small text-muted mb-4">Или наведите камеру на QR — в приложении AmneziaWG «Сканировать QR-код».</p>
+
+        <hr>
+        <h6 class="fw-bold mt-4 mb-3">🔄 Продлить ещё на {{ free_hours }} ч</h6>
+        <p class="small text-muted">Продление бесплатно и работает сколько угодно раз. Срок обновляется с момента нажатия.</p>
+
+        <form method="post" action="/free/config" class="mx-auto" style="max-width:360px">
+            <input type="hidden" name="action" value="renew">
+            <input type="hidden" name="captcha_id" id="captcha-id">
+            <label class="form-label fw-bold small mb-1">Капча: <span id="captcha-question">загрузка...</span>
+                <button type="button" class="btn btn-link btn-sm p-0 ms-1" onclick="loadCaptcha()">↻ новый вопрос</button>
+            </label>
+            <input type="number" class="form-control form-control-lg text-center rounded-pill mb-3" id="captcha-answer" name="captcha_answer" placeholder="Ответ" required>
+            <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 fw-bold w-100">🔄 Продлить</button>
+        </form>
+
+        <div class="small text-muted mt-4">Забыли продлить — конфиг выключится, но вы всегда можете оформить новый бесплатно с этой же страницы.</div>
+    </div>
+
+{% else %}
+    <!-- Нет активной записи: выбрать сервер и получить новый конфиг -->
+    <div class="card card-custom p-4 p-md-5">
+        <h4 class="fw-bold mb-3 text-center">Выберите бесплатный сервер</h4>
+
+        {% if servers %}
+        <form method="post" action="/free/config" class="mx-auto" style="max-width:480px">
+            <input type="hidden" name="action" value="grant">
+            <input type="hidden" name="captcha_id" id="captcha-id">
+
+            <div class="d-grid gap-2 mb-4">
+                {% for s in servers %}
+                <label class="server-card d-flex justify-content-between align-items-center rounded-4 p-3 border {% if not s.free %}opacity-50{% endif %}">
+                    <span>
+                        <input type="radio" name="server_id" value="{{ s.id }}" {% if not s.free %}disabled{% endif %} required>
+                        <b>{{ '🇷🇺' if 'RUS' in s.name.upper() else '🌍' }} {{ s.name }}</b>
+                    </span>
+                    <small class="text-muted">занято {{ s.taken }}/{{ s.limit }}{% if not s.free %} — мест нет{% endif %}</small>
+                </label>
+                {% endfor %}
+            </div>
+
+            <div class="text-center">
+                <label class="form-label fw-bold small mb-1">Капча: <span id="captcha-question">загрузка...</span>
+                    <button type="button" class="btn btn-link btn-sm p-0 ms-1" onclick="loadCaptcha()">↻ новый вопрос</button>
+                </label>
+                <input type="number" class="form-control form-control-lg text-center rounded-pill mb-3 mx-auto" id="captcha-answer" name="captcha_answer" placeholder="Ответ" style="max-width:240px" required>
+                <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 fw-bold">🎁 Получить конфиг (на {{ free_hours }} ч)</button>
+                <div class="small text-muted mt-3">Одна активная бесплатная конфигурация на один IP.</div>
+            </div>
+        </form>
+        {% else %}
+        <div class="alert alert-warning rounded-3 text-center">
+            Пока ни одного бесплатного сервера в списке нет или все переполнены.
+            Загляните чуть позже — администратор добавляет серверы по мере спроса.
+        </div>
+        {% endif %}
+    </div>
+{% endif %}
+
+    <div class="text-center mt-4">
+        <a href="/free" class="btn btn-outline-secondary rounded-pill px-4">← Назад к условиям</a>
+    </div>
+</div>
+
+<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
+<script src="/static/cookie-consent.js"></script>
+<script>
+    async function loadCaptcha() {
+        try {
+            const res = await fetch('/api/captcha');
+            const data = await res.json();
+            document.getElementById('captcha-question').innerText = data.question;
+            document.getElementById('captcha-id').value = data.captcha_id;
+            document.getElementById('captcha-answer').value = '';
+        } catch (e) {
+            document.getElementById('captcha-question').innerText = 'ошибка загрузки, обновите страницу';
+        }
+    }
+    document.addEventListener('DOMContentLoaded', function() {
+        loadCaptcha();
+        // подсветка выбранной карточки сервера
+        document.querySelectorAll('.server-card input[type=radio]').forEach(function(r){
+            r.addEventListener('change', function(){
+                document.querySelectorAll('.server-card').forEach(c => c.classList.remove('active-server'));
+                if (r.checked) r.closest('.server-card').classList.add('active-server');
+            });
+        });
+    });
+</script>
+</body>
+</html>
