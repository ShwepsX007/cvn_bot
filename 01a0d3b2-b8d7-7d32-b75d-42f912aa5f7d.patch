+        <div class="col-md-4">
+            <label class="form-label small text-muted">Название (локация)</label>
+            <input type="text" name="name" class="form-control" placeholder="напр. 🇳🇱 Нидерланды" required>
+        </div>
+        <div class="col-md-1">
+            <label class="form-label small text-muted">🎁 сайт-only</label>
+            <div class="form-check form-switch mt-1">
+                <input class="form-check-input" type="checkbox" name="is_free" id="add_is_free" title="Бесплатная нода для страницы /free - в боте не показывается">
+            </div>
