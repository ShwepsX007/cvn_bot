@@ -0,0 +1,66 @@
+<!DOCTYPE html>
+<html lang="ru" data-bs-theme="dark">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Привязка Telegram — AmneziaWG VPN</title>
+    <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
+    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32x32.png">
+    <link rel="icon" type="image/png" sizes="16x16" href="/static/favicon-16x16.png">
+    <link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png">
+    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
+    <style>
+        body {
+            background: linear-gradient(135deg, #0d6efd, #0dcaf0);
+            min-height: 100vh;
+            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+            display: flex;
+            align-items: center;
+        }
+        .login-card {
+            border: none;
+            border-radius: 24px;
+            box-shadow: 0 20px 50px rgba(0,0,0,0.25);
+        }
+        .tg-btn-wrap { min-height: 48px; display: flex; justify-content: center; align-items: center; }
+    </style>
+    <link rel="stylesheet" href="/static/dark-theme.css">
+</head>
+<body>
+<div class="container">
+    <div class="row justify-content-center">
+        <div class="col-md-6 col-lg-5">
+            <div class="card login-card p-4 p-md-5 bg-white text-center">
+
+                <h3 class="fw-bold mb-3">🔗 Привяжите Telegram</h3>
+                <p class="text-muted">Вы вошли по почте <b>{{ email }}</b>. Последний шаг — привяжите Telegram-аккаунт: туда бот присылает конфиги VPN, уведомления о подписке и ответы поддержки.</p>
+
+                {% if bot_username %}
+                <div class="tg-btn-wrap my-4">
+                    <script async src="https://telegram.org/js/telegram-widget.js?22"
+                        data-telegram-login="{{ bot_username }}"
+                        data-size="large"
+                        data-radius="12"
+                        data-auth-url="{{ site_url }}/auth/telegram"
+                        data-request-access="write">
+                    </script>
+                </div>
+                <p class="text-muted small">Нажмите кнопку выше и подтвердите вход — почта привяжется к этому Telegram автоматически, и вы попадете в кабинет.</p>
+
