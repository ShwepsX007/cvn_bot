+async def delete_amnezia_peer(ip: str, port: int, peer_id: str):
+    cmd = f"bash /root/remove_user.sh {peer_id}"
+    result = await ssh.run_ssh_command(ip, port, cmd)
+    if "Ошибка" in result:
+        raise Exception(f"Ошибка SSH при удалении: {result}")
